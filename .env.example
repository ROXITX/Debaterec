# ---------------------------------------------------------------------------
# DebateRec configuration
# Copy this file to ".env" and fill in your key.
#   macOS / Linux :  cp .env.example .env
#   Windows (cmd) :  copy .env.example .env
# ---------------------------------------------------------------------------

# Which LLM backend drives the Supporter / Critic / Judge agents.
# Options: gemini | ollama | mock
# "mock" needs no key at all and runs a deterministic rule-based debate,
# which is useful for offline demos and for reproducible unit tests.
LLM_PROVIDER=gemini

# --- Google Gemini ----------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# A stronger model may be used for the Judge only. Leave blank to reuse the above.
GEMINI_JUDGE_MODEL=

# Requests per minute. The free tier is roughly 10-15. One full debate over eight
# candidates is 25 calls, so without this the first query burns the whole minute's
# quota and everything after it is rejected with HTTP 429. Set 0 to disable.
GEMINI_RPM=10

# --- Ollama (local, offline) ------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Retrieval --------------------------------------------------------------
# lexical  = BM25 + TF-IDF hybrid (default, zero download, instant startup)
# semantic = sentence-transformers embeddings (needs `pip install sentence-transformers`)
RETRIEVAL_MODE=lexical
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Pipeline sizing (these are the RQ5 latency/cost knobs) -----------------
CANDIDATES_STAGE1=50     # after hybrid retrieval
# How many candidates actually get debated. This is THE cost knob: each one
# costs three LLM calls. 8 is right for deterministic mode; drop to 4 or 5 when
# running against a free-tier API key, or a single query takes minutes.
CANDIDATES_DEBATE=8
RESULTS_FINAL=5          # how many make it to the user
DEBATE_REBUTTAL=false    # enable the optional round-3 rebuttal

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
